# Set these in Vercel Project Settings > Environment Variables (never commit real values).
MONGODB_URI=mongodb+srv://<least-privilege-user>:<password>@<cluster-host>/comms?retryWrites=true&w=majority
MONGODB_DB_NAME=comms
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ADMIN_USERNAME=admin
ADMIN_ACCOUNT_NAME=Main Admin
ADMIN_PASSWORD=replace-with-a-unique-long-password
